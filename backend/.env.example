# VajraTwin backend — environment configuration (local-first, no cloud).
# Copy to .env and adjust as needed. Safe localhost/demo defaults below.

# ── MongoDB (primary persistence) ────────────────────────────────────────────
# If MongoDB is unreachable the backend automatically falls back to an
# in-memory DEMO MODE and keeps running. It never crashes without MongoDB.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=vajratwin
MONGODB_TIMEOUT_MS=1500

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ── CORS (comma-separated allowed origins) ────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173

# ── AI / XAI provider (OPTIONAL) ──────────────────────────────────────────────
# Leave LLM_API_KEY empty to use the built-in deterministic explainer.
# The app NEVER depends on an external LLM for health decisions.
LLM_PROVIDER=deterministic
LLM_API_KEY=
LLM_API_BASE=
LLM_MODEL=

# ── Engine identity ────────────────────────────────────────────────────────────
DEFAULT_ENGINE_ID=rotax-914-uav-01
